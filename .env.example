# Required Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional Configuration
# OPENAI_MODEL=gpt-3.5-turbo  # Leave empty for auto-selection
MODEL_PREFERENCE=CHEAPEST  # FASTEST or CHEAPEST (default: CHEAPEST)
DATABASE_URL=postgresql+asyncpg://localhost:5432/gateway
REDIS_URL=redis://localhost:6379
AUTO_CREATE_USERS=true
ADMIN_API_KEY=your-admin-key-here
BLOCK_DURATION_HOURS=24  # Hours until automatic unblock (default: 24)
LOG_LEVEL=INFO
