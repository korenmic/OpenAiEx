apiVersion: v1
kind: Secret
metadata:
  name: gateway-secrets
type: Opaque
stringData:
  openai-api-key: "sk-your-openai-api-key-here"
  admin-api-key: "your-admin-api-key-here"
---
# To create the secret:
# 1. Copy this file to secrets.yaml
# 2. Replace the placeholder values with your actual keys
# 3. Apply: kubectl apply -f k8s/secrets.yaml
# 4. Add secrets.yaml to .gitignore to prevent committing secrets
